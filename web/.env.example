# ==============================================================================
# rAthena Solo Player Portal - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local when running the web portal on host machines.
# NEVER commit your production .env file with live secrets to Git.

# --- Web Server Configuration ---
PORT=4000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_signing_key_change_me_in_production

# --- MariaDB Read-Only Replica Configuration (Port 3307 on host, 3306 in Docker) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=ro_user
DB_PASSWORD=ro_password
DB_DATABASE=ragnarok

# --- MariaDB Primary Database Configuration (Port 3306 on host, 3306 in Docker) ---
PRIMARY_DB_HOST=127.0.0.1
PRIMARY_DB_PORT=3306
PRIMARY_DB_USER=ragnarok
PRIMARY_DB_PASSWORD=ragnarok
PRIMARY_DB_DATABASE=ragnarok
