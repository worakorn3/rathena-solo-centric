# =====================================================================
# rAthena Solo Centric - Docker Environment Variables
# =====================================================================
# Copy this file to '.env' in this directory (tools/docker/.env):
# cp .env.example .env
#
# Fill in your Ngrok credentials below:
# =====================================================================

# 1. Ngrok Auth Token (Required for Ngrok tunnel)
# Get yours from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# 2. Ngrok Static / Custom Domain (Optional)
# If you have a claimed free static domain in your Ngrok dashboard
# (e.g. your-name.ngrok-free.app), uncomment and set it here.
# If left blank, Ngrok will generate a random URL each time it starts.
# NGROK_DOMAIN=your-name.ngrok-free.app
